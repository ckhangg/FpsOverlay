<!--
    Chủ đề Neon tím cho cửa sổ cài đặt / cài đặt app (bám bản vẽ themed-settings-v5, lớp .neon): nền #140620, viền
    #C64BFF phát sáng tím, bo góc 14, điểm nhấn hồng #FF4FD8 phát sáng, nút dạng viên thuốc.
    Tiêu đề dùng Chakra Petch giãn chữ rộng + phát sáng hồng (Orbitron của bản vẽ không có chữ tiếng Việt có dấu);
    số dùng JetBrains Mono.

    Cùng tập khoá Ui.* với Cyberpunk.xaml (ThemeKeysTests kiểm tra); chỉ gắn khoá bằng DynamicResource (trừ BasedOn).
    Khung cửa sổ cố định (WindowStyle=None, AllowsTransparency, nền trong suốt) nằm ở style Ui.Window trong App.xaml,
    nên góc bo và quầng sáng ngoài vẽ ngay trong Ui.WindowTemplate, chừa lề 12px quanh khung cho quầng sáng.

    Hiệu ứng phát sáng (DropShadowEffect) chỉ gắn vào khối nền / chữ tiêu đề riêng, không gắn vào khung có chữ con
    bên trong: hiệu ứng trên khung chứa sẽ vẽ lại cả nội dung qua bitmap, chữ mất nét.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:th="clr-namespace:FpsOverlay.Themes">

    <FontFamily x:Key="Ui.Font">pack://application:,,,/Assets/Fonts/#Chakra Petch</FontFamily>
    <FontFamily x:Key="Ui.Mono">pack://application:,,,/Assets/Fonts/#JetBrains Mono</FontFamily>
    <sys:Double x:Key="Ui.FontSize">15</sys:Double>
    <FontWeight x:Key="Ui.FontWeight">Medium</FontWeight>

    <!-- Ký hiệu mục thu gọn (đóng / đang mở) và chữ trên công tắc; Ui.OnText/OffText bị App ghi đè theo ngôn ngữ. -->
    <sys:String x:Key="Ui.ExpandGlyph">▾</sys:String>
    <sys:String x:Key="Ui.CollapseGlyph">▴</sys:String>
    <sys:String x:Key="Ui.OnText">BẬT</sys:String>
    <sys:String x:Key="Ui.OffText">TẮT</sys:String>

    <SolidColorBrush x:Key="Ui.WindowBackground" Color="#140620" />
    <SolidColorBrush x:Key="Ui.Accent" Color="#FF4FD8" />
    <SolidColorBrush x:Key="Ui.AccentHover" Color="#FF7FE3" />
    <SolidColorBrush x:Key="Ui.AccentPressed" Color="#E033BC" />
    <SolidColorBrush x:Key="Ui.Secondary" Color="#C9A8FF" />
    <SolidColorBrush x:Key="Ui.Danger" Color="#FF4D6D" />
    <SolidColorBrush x:Key="Ui.DangerTint" Color="#33FF4D6D" />
    <SolidColorBrush x:Key="Ui.Text" Color="#F3E6FF" />
    <SolidColorBrush x:Key="Ui.Track" Color="#3A1450" />
    <SolidColorBrush x:Key="Ui.Outline" Color="#6A2A8A" />
    <SolidColorBrush x:Key="Ui.Divider" Color="#4A1E66" />
    <SolidColorBrush x:Key="Ui.Field" Color="#0E0418" />
    <SolidColorBrush x:Key="Ui.Muted" Color="#9A7AB8" />

    <!-- Khung chỉ báo focus khi dùng bàn phím (Tab); bấm chuột thì không hiện. -->
    <Style x:Key="Ui.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="{DynamicResource Ui.Accent}" StrokeThickness="1" StrokeDashArray="2 2"
                               RadiusX="8" RadiusY="8" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Cửa sổ: lề 12px cho quầng sáng, khung bo 14 viền #C64BFF 1.5, thanh tiêu đề cao 44px ===== -->
    <!-- Vùng kéo cửa sổ = lề trên 12 + thanh tiêu đề 44. -->
    <WindowChrome x:Key="Ui.WindowChrome" CaptionHeight="56" GlassFrameThickness="0" ResizeBorderThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False" />

    <ControlTemplate x:Key="Ui.WindowTemplate" TargetType="Window">
        <!-- Lề 12px là Padding của khung ngoài cùng, không dùng Margin: WindowChrome tự đặt lại Margin của gốc template. -->
        <Border Padding="12">
            <Grid>
                <!-- Quầng sáng tím #B026FF quanh khung: khối nền riêng, không chứa chữ. -->
                <Border CornerRadius="14" Background="{DynamicResource Ui.WindowBackground}">
                    <Border.Effect>
                        <DropShadowEffect Color="#B026FF" ShadowDepth="0" BlurRadius="18" Opacity="0.6" />
                    </Border.Effect>
                </Border>
                <Border CornerRadius="14" Background="{DynamicResource Ui.WindowBackground}" BorderBrush="#C64BFF"
                        BorderThickness="1.5" UseLayoutRounding="False">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Height="44" Padding="18,0,8,0" BorderBrush="#66C64BFF" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{DynamicResource Ui.CloseButton}"
                                        Command="{x:Static SystemCommands.CloseWindowCommand}"
                                        WindowChrome.IsHitTestVisibleInChrome="True" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Converter={x:Static th:LetterSpacing.Converter}, ConverterParameter=2}"
                                               Foreground="{DynamicResource Ui.Accent}" FontWeight="Bold" FontSize="17"
                                               VerticalAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#FF4FD8" ShadowDepth="0" BlurRadius="10" Opacity="0.9" />
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="FPS OVERLAY" Margin="12,2,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Ui.Secondary}" FontFamily="{DynamicResource Ui.Mono}"
                                               FontSize="11" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ContentPresenter />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </ControlTemplate>

    <!-- Nút đóng ✕ trên thanh tiêu đề: tím nhạt, rê chuột thì hồng phát sáng. -->
    <Style x:Key="Ui.CloseButton" TargetType="Button">
        <Setter Property="Content" Value="&#xE8BB;" />
        <Setter Property="Foreground" Value="{DynamicResource Ui.Secondary}" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Width="30" Height="30">
                        <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FF4FD8" ShadowDepth="0" BlurRadius="8" Opacity="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Ui.Accent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Chữ ===== -->
    <!-- Tiêu đề mục: "// GIAO DIỆN" Chakra Petch đậm, giãn chữ, hồng phát sáng; kẻ mảnh tím bên dưới -->
    <Style x:Key="Ui.Section" TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource Ui.Accent}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,8,0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Label">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,3"
                                   Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static th:LetterSpacing.Converter}, ConverterParameter=1}">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FF4FD8" ShadowDepth="0" BlurRadius="7" Opacity="0.85" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <Rectangle Height="1" Fill="{DynamicResource Ui.Divider}" SnapsToDevicePixels="True" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nhãn của một dòng cài đặt; lề trên/dưới tạo khoảng cách giữa các dòng -->
    <Style x:Key="Ui.FieldLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,7,12,7" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Số ở cột phải: JetBrains Mono tím nhạt -->
    <Style x:Key="Ui.Value" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Ui.Mono}" />
        <Setter Property="Foreground" Value="{DynamicResource Ui.Secondary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Nút: dạng viên thuốc ===== -->
    <Style x:Key="Ui.ButtonBase" TargetType="Button">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Ui.FocusVisual}" />
        <Setter Property="Padding" Value="18,6" />
    </Style>

    <!-- Nút chính: nền hồng phát sáng, chữ tím than -->
    <Style x:Key="Ui.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Ui.ButtonBase}">
        <Setter Property="Foreground" Value="#140620" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Glow" CornerRadius="999" Background="{DynamicResource Ui.Accent}">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF4FD8" ShadowDepth="0" BlurRadius="12" Opacity="0.9" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Bd" CornerRadius="999" Background="{DynamicResource Ui.Accent}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.AccentPressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút phụ: viền tím, chữ trắng tím; rê chuột thì viền hồng -->
    <Style x:Key="Ui.GhostButton" TargetType="Button" BasedOn="{StaticResource Ui.ButtonBase}">
        <Setter Property="Foreground" Value="{DynamicResource Ui.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="999"
                            BorderBrush="{DynamicResource Ui.Outline}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Accent}" />
                            <Setter TargetName="Bd" Property="Background" Value="#1FFF4FD8" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#40FF4FD8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tiêu đề mục thu gọn: nút phẳng, thao tác được bằng bàn phím -->
    <Style x:Key="Ui.HeaderButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Outline}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Nút phân đoạn (RadioButton): viên tròn viền tím, chọn = viền + chữ hồng phát sáng ===== -->
    <Style x:Key="Ui.Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Ui.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Padding" Value="12,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Ui.FocusVisual}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Glow" CornerRadius="999" BorderBrush="{DynamicResource Ui.Accent}" BorderThickness="1"
                                Visibility="Hidden">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF4FD8" ShadowDepth="0" BlurRadius="8" Opacity="1" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Ui.Outline}"
                                BorderThickness="1" CornerRadius="999" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Accent}" />
                            <Setter TargetName="Bd" Property="Background" Value="#26FF4FD8" />
                            <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Ui.Accent}" />
                <Setter Property="FontWeight" Value="Bold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Thanh trượt: rãnh tím, phần đã chọn chuyển tím→hồng phát sáng, núm tròn phát sáng ===== -->
    <Style x:Key="Ui.SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Rectangle Height="4" VerticalAlignment="Center" RadiusX="2" RadiusY="2">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#C64BFF" />
                                    <GradientStop Offset="1" Color="#FF4FD8" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.Effect>
                                <DropShadowEffect Color="#FF4FD8" ShadowDepth="0" BlurRadius="7" Opacity="0.9" />
                            </Rectangle.Effect>
                        </Rectangle>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ui.SliderRest" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Rectangle Height="4" VerticalAlignment="Center" RadiusX="2" RadiusY="2"
                                   Fill="{DynamicResource Ui.Track}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ui.SliderThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{DynamicResource Ui.Text}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FF4FD8" ShadowDepth="0" BlurRadius="9" Opacity="1" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Ui.AccentHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ui.Slider" TargetType="Slider">
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Ui.FocusVisual}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="22" Background="Transparent">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{DynamicResource Ui.SliderFill}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{DynamicResource Ui.SliderRest}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{DynamicResource Ui.SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Công tắc (ToggleButton): viên tròn tím, bật = núm hồng + phát sáng hồng ===== -->
    <Style x:Key="Ui.Switch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Ui.FocusVisual}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="40" Height="18">
                        <Border x:Name="Glow" CornerRadius="9" Background="{DynamicResource Ui.Track}" Visibility="Hidden">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF4FD8" ShadowDepth="0" BlurRadius="8" Opacity="1" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Bd" CornerRadius="9" Background="{DynamicResource Ui.Track}"
                                BorderBrush="{DynamicResource Ui.Outline}" BorderThickness="1">
                            <Ellipse x:Name="Knob" Width="12" Height="12" Margin="2,0" HorizontalAlignment="Left"
                                     VerticalAlignment="Center" Fill="{DynamicResource Ui.Muted}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Accent}" />
                            <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Ui.Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Ô tick (CheckBox): bo 4, tick = nền hồng phát sáng ===== -->
    <Style x:Key="Ui.Check" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Ui.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource Ui.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Ui.Text}" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Border x:Name="Glow" CornerRadius="4" Background="{DynamicResource Ui.Accent}" Visibility="Hidden">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF4FD8" ShadowDepth="0" BlurRadius="8" Opacity="0.9" />
                                </Border.Effect>
                            </Border>
                            <Border x:Name="Bd" CornerRadius="4" Background="{DynamicResource Ui.Track}"
                                    BorderBrush="{DynamicResource Ui.Outline}" BorderThickness="1">
                                <Path x:Name="Mark" Data="M2.5,7.5 L6,11 L12.5,4" Stroke="#140620" StrokeThickness="2"
                                      Visibility="Collapsed" />
                            </Border>
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Accent}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Accent}" />
                            <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Ô nhập mã hex: Tag="invalid" thì viền đỏ ===== -->
    <Style x:Key="Ui.HexBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Ui.Mono}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Ui.Secondary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Ui.Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Ui.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ui.Outline}" />
        <Setter Property="MaxLength" Value="7" />
        <Setter Property="CharacterCasing" Value="Upper" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <!-- Ô nhập tự đổi viền khi focus (trigger bên dưới), không cần khung focus riêng. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{DynamicResource Ui.Field}" BorderThickness="1" CornerRadius="6"
                            BorderBrush="{TemplateBinding BorderBrush}" Padding="5,2">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Ui.Secondary}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Ui.Accent}" />
            </Trigger>
            <Trigger Property="Tag" Value="invalid">
                <Setter Property="BorderBrush" Value="{DynamicResource Ui.Danger}" />
                <Setter Property="Foreground" Value="{DynamicResource Ui.Danger}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Ô màu gợi ý (RadioButton): Background là màu; ô tròn, chọn = vòng hồng ===== -->
    <Style x:Key="Ui.Swatch" TargetType="RadioButton">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Ui.FocusVisual}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Ring" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="11">
                        <Border BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="9" Background="{TemplateBinding Background}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="#88FF4FD8" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Ui.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

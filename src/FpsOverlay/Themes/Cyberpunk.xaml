<!--
    Chủ đề Cyberpunk cho cửa sổ cài đặt / cài đặt app (bám mockup cyberpunk-v2). Tự viết, không dùng thư viện giao diện.
    Font Chakra Petch cho chữ, JetBrains Mono cho số; cả hai có đủ bộ ký tự tiếng Việt.

    Mỗi file trong Themes/ là một chủ đề, định nghĩa CÙNG một tập khoá Ui.* (ThemeKeysTests kiểm tra); ThemeManager
    thay cả dictionary khi đổi phong cách. Cửa sổ và style chỉ gắn khoá bằng DynamicResource (trừ BasedOn).
    Khung cửa sổ cố định (WindowStyle=None, AllowsTransparency, nền trong suốt) nằm ở style Ui.Window trong App.xaml;
    chủ đề chỉ vẽ phần nhìn thấy qua Ui.WindowTemplate và chọn vùng kéo qua Ui.WindowChrome.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:th="clr-namespace:FpsOverlay.Themes">

    <FontFamily x:Key="Ui.Font">pack://application:,,,/Assets/Fonts/#Chakra Petch</FontFamily>
    <FontFamily x:Key="Ui.Mono">pack://application:,,,/Assets/Fonts/#JetBrains Mono</FontFamily>
    <sys:Double x:Key="Ui.FontSize">15</sys:Double>
    <FontWeight x:Key="Ui.FontWeight">Medium</FontWeight>
    <!-- Chữ phụ (tóm tắt, phiên bản, ghi chú) và nút nhỏ / tên ứng dụng. -->
    <sys:Double x:Key="Ui.SmallFontSize">11</sys:Double>
    <sys:Double x:Key="Ui.CompactFontSize">12</sys:Double>

    <!-- Ký hiệu mục thu gọn (đóng / đang mở) và chữ trên công tắc; Ui.OnText/OffText bị App ghi đè theo ngôn ngữ. -->
    <sys:String x:Key="Ui.ExpandGlyph">▾</sys:String>
    <sys:String x:Key="Ui.CollapseGlyph">▴</sys:String>
    <sys:String x:Key="Ui.OnText">BẬT</sys:String>
    <sys:String x:Key="Ui.OffText">TẮT</sys:String>

    <SolidColorBrush x:Key="Ui.WindowBackground" Color="#0A0A0F" />
    <SolidColorBrush x:Key="Ui.Accent" Color="#FCEE0A" />
    <SolidColorBrush x:Key="Ui.AccentHover" Color="#FFF55C" />
    <SolidColorBrush x:Key="Ui.AccentPressed" Color="#D6C900" />
    <SolidColorBrush x:Key="Ui.Secondary" Color="#00F0FF" />
    <SolidColorBrush x:Key="Ui.Danger" Color="#FF003C" />
    <SolidColorBrush x:Key="Ui.DangerTint" Color="#33FF003C" />
    <SolidColorBrush x:Key="Ui.Text" Color="#D8D8E0" />
    <SolidColorBrush x:Key="Ui.Track" Color="#2A2A35" />
    <SolidColorBrush x:Key="Ui.Outline" Color="#44444F" />
    <SolidColorBrush x:Key="Ui.Divider" Color="#33333F" />
    <SolidColorBrush x:Key="Ui.Field" Color="#12121A" />
    <SolidColorBrush x:Key="Ui.Muted" Color="#77778A" />

    <!-- Khung chỉ báo focus khi dùng bàn phím (Tab); bấm chuột thì không hiện. -->
    <Style x:Key="Ui.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="{DynamicResource Ui.Secondary}" StrokeThickness="1" StrokeDashArray="2 2"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Cửa sổ: nền tối, góc trên phải và dưới trái vát 22px, thanh tiêu đề tự vẽ cao 44px ===== -->
    <!-- Vùng kéo cửa sổ = thanh tiêu đề. -->
    <WindowChrome x:Key="Ui.WindowChrome" CaptionHeight="44" GlassFrameThickness="0" ResizeBorderThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False" />

    <ControlTemplate x:Key="Ui.WindowTemplate" TargetType="Window">
        <th:ChamferBorder Background="{DynamicResource Ui.WindowBackground}" BorderBrush="{DynamicResource Ui.Track}"
                          BorderThickness="1" TopRight="22" BottomLeft="22">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="44" Padding="16,0,26,0"
                        BorderBrush="{DynamicResource Ui.Danger}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{DynamicResource Ui.CloseButton}" Content="[ X ]"
                                Command="{x:Static SystemCommands.CloseWindowCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="FPS//OVERLAY" Foreground="{DynamicResource Ui.Accent}" FontWeight="Bold" FontSize="20" />
                            <Run Text=" " FontSize="20" />
                            <Run Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                 Foreground="{DynamicResource Ui.Danger}" FontFamily="{DynamicResource Ui.Mono}" FontSize="11" />
                        </TextBlock>
                    </DockPanel>
                </Border>
                <ContentPresenter />
            </DockPanel>
        </th:ChamferBorder>
    </ControlTemplate>

    <!-- Nút [ X ] trên thanh tiêu đề -->
    <Style x:Key="Ui.CloseButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Ui.Danger}" />
        <Setter Property="FontFamily" Value="{DynamicResource Ui.Mono}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="4,2">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Ui.Accent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Chữ ===== -->
    <!-- Tiêu đề mục: "// GIAO DIỆN", gạch đứt bên dưới -->
    <Style x:Key="Ui.Section" TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource Ui.Danger}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,8,0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Label">
                    <StackPanel>
                        <ContentPresenter Margin="0,0,0,3" />
                        <Rectangle Height="1" Stroke="{DynamicResource Ui.Divider}" StrokeThickness="1"
                                   StrokeDashArray="3 2" SnapsToDevicePixels="True" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nhãn của một dòng cài đặt: xuống dòng khi dài (không cắt "…"); lề trên/dưới tạo khoảng cách giữa các dòng -->
    <Style x:Key="Ui.FieldLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,7,12,7" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <!-- Số ở cột phải: JetBrains Mono xanh cyan -->
    <Style x:Key="Ui.Value" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Ui.Mono}" />
        <Setter Property="Foreground" Value="{DynamicResource Ui.Secondary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Nút ===== -->
    <Style x:Key="Ui.ButtonBase" TargetType="Button">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Ui.FocusVisual}" />
        <Setter Property="Padding" Value="18,6" />
    </Style>

    <!-- Nút chính: nền vàng, chữ đen -->
    <Style x:Key="Ui.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Ui.ButtonBase}">
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <th:ChamferBorder x:Name="Bd" Background="{DynamicResource Ui.Accent}" BottomRight="8"
                                      BorderBrush="{DynamicResource Ui.Accent}" BorderThickness="1"
                                      Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </th:ChamferBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.AccentPressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút phụ: viền đỏ, chữ đỏ -->
    <Style x:Key="Ui.GhostButton" TargetType="Button" BasedOn="{StaticResource Ui.ButtonBase}">
        <Setter Property="Foreground" Value="{DynamicResource Ui.Danger}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <th:ChamferBorder x:Name="Bd" Background="Transparent" BottomRight="8"
                                      BorderBrush="{DynamicResource Ui.Danger}" BorderThickness="1"
                                      Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </th:ChamferBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.DangerTint}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Danger}" />
                            <Setter Property="Foreground" Value="Black" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tiêu đề mục thu gọn: nút phẳng, giữ nguyên giao diện cũ, thao tác được bằng bàn phím -->
    <Style x:Key="Ui.HeaderButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Divider}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Nút phân đoạn (RadioButton): chọn = nền vàng chữ đen ===== -->
    <Style x:Key="Ui.Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Ui.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Padding" Value="12,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Ui.FocusVisual}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <th:ChamferBorder x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Ui.Outline}"
                                      BorderThickness="1" BottomRight="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </th:ChamferBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Accent}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="FontWeight" Value="Bold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Thanh trượt: rãnh #2A2A35, phần đã chọn cyan phát sáng, núm vàng nghiêng ===== -->
    <Style x:Key="Ui.SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Rectangle Height="4" VerticalAlignment="Center" Fill="{DynamicResource Ui.Secondary}">
                            <Rectangle.Effect>
                                <DropShadowEffect Color="#00F0FF" ShadowDepth="0" BlurRadius="8" Opacity="0.9" />
                            </Rectangle.Effect>
                        </Rectangle>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ui.SliderRest" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Rectangle Height="4" VerticalAlignment="Center" Fill="{DynamicResource Ui.Track}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ui.SliderThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Rectangle x:Name="Knob" Width="10" Height="16" Fill="{DynamicResource Ui.Accent}"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <SkewTransform AngleX="-15" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Ui.AccentHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ui.Slider" TargetType="Slider">
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Ui.FocusVisual}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="22" Background="Transparent">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{DynamicResource Ui.SliderFill}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{DynamicResource Ui.SliderRest}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{DynamicResource Ui.SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Công tắc (ToggleButton) ===== -->
    <Style x:Key="Ui.Switch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Ui.FocusVisual}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <th:ChamferBorder x:Name="Bd" Width="40" Height="18" Background="{DynamicResource Ui.Track}"
                                      BorderBrush="{DynamicResource Ui.Track}" BorderThickness="1" BottomRight="5">
                        <Rectangle x:Name="Knob" Width="12" Height="12" Margin="2,0" HorizontalAlignment="Left"
                                   VerticalAlignment="Center" Fill="{DynamicResource Ui.Muted}" />
                    </th:ChamferBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Accent}" />
                            <Setter TargetName="Knob" Property="Fill" Value="Black" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Ô tick (CheckBox): cùng màu với công tắc ===== -->
    <Style x:Key="Ui.Check" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Ui.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource Ui.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Ui.Text}" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <th:ChamferBorder x:Name="Bd" Width="16" Height="16" Background="{DynamicResource Ui.Track}"
                                          BorderBrush="{DynamicResource Ui.Track}" BorderThickness="1" BottomRight="4"
                                          VerticalAlignment="Center">
                            <Path x:Name="Mark" Data="M3,8 L6.5,11.5 L13,4.5" Stroke="Black" StrokeThickness="2"
                                  Visibility="Collapsed" />
                        </th:ChamferBorder>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Accent}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Ô nhập mã hex: Tag="invalid" thì viền đỏ ===== -->
    <Style x:Key="Ui.HexBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Ui.Mono}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Ui.Secondary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Ui.Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Ui.Secondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ui.Outline}" />
        <Setter Property="MaxLength" Value="7" />
        <Setter Property="CharacterCasing" Value="Upper" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <!-- Ô nhập tự đổi viền khi focus (trigger bên dưới), không cần khung focus riêng. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{DynamicResource Ui.Field}" BorderThickness="1"
                            BorderBrush="{TemplateBinding BorderBrush}" Padding="4,2">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Ui.Accent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Ui.Secondary}" />
            </Trigger>
            <Trigger Property="Tag" Value="invalid">
                <Setter Property="BorderBrush" Value="{DynamicResource Ui.Danger}" />
                <Setter Property="Foreground" Value="{DynamicResource Ui.Danger}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Ô màu gợi ý (RadioButton): Background là màu; chọn = khung vàng ===== -->
    <Style x:Key="Ui.Swatch" TargetType="RadioButton">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Ui.FocusVisual}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Ring" Background="Transparent" BorderBrush="Transparent" BorderThickness="2">
                        <Border BorderBrush="#555555" BorderThickness="1" Background="{TemplateBinding Background}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="#88FCEE0A" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Ui.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Thanh cuộn dọc của vùng nội dung: rãnh #2A2A35 góc vuông, núm #44444F, rê chuột / kéo thì cyan ===== -->
    <Style x:Key="Ui.ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ui.ScrollThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" CornerRadius="0" Background="{DynamicResource Ui.Outline}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Ui.Secondary}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Ui.Secondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ui.ScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{DynamicResource Ui.Track}" CornerRadius="0">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{DynamicResource Ui.ScrollPage}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{DynamicResource Ui.ScrollPage}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{DynamicResource Ui.ScrollThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vùng cuộn của cửa sổ: nội dung + thanh cuộn dọc theo chủ đề (cuộn ngang không dùng). -->
    <Style x:Key="Ui.ScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Margin="0,4,4,4"
                                   Style="{DynamicResource Ui.ScrollBar}"
                                   Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

<!--
    Kiểu Cyberpunk cho cửa sổ cài đặt (bám mockup cyberpunk-v2). Tự viết, không dùng thư viện giao diện.
    Font Chakra Petch cho chữ, JetBrains Mono cho số; cả hai có đủ bộ ký tự tiếng Việt.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:th="clr-namespace:FpsOverlay.Themes">

    <FontFamily x:Key="Cp.Font">pack://application:,,,/Assets/Fonts/#Chakra Petch</FontFamily>
    <FontFamily x:Key="Cp.Mono">pack://application:,,,/Assets/Fonts/#JetBrains Mono</FontFamily>

    <SolidColorBrush x:Key="Cp.Background" Color="#0A0A0F" />
    <SolidColorBrush x:Key="Cp.Yellow" Color="#FCEE0A" />
    <SolidColorBrush x:Key="Cp.YellowHover" Color="#FFF55C" />
    <SolidColorBrush x:Key="Cp.YellowPressed" Color="#D6C900" />
    <SolidColorBrush x:Key="Cp.Cyan" Color="#00F0FF" />
    <SolidColorBrush x:Key="Cp.Red" Color="#FF003C" />
    <SolidColorBrush x:Key="Cp.RedTint" Color="#33FF003C" />
    <SolidColorBrush x:Key="Cp.Text" Color="#D8D8E0" />
    <SolidColorBrush x:Key="Cp.Track" Color="#2A2A35" />
    <SolidColorBrush x:Key="Cp.Outline" Color="#44444F" />
    <SolidColorBrush x:Key="Cp.Dashed" Color="#33333F" />
    <SolidColorBrush x:Key="Cp.Field" Color="#12121A" />
    <SolidColorBrush x:Key="Cp.KnobOff" Color="#77778A" />

    <!-- Khung chỉ báo focus khi dùng bàn phím (Tab); bấm chuột thì không hiện. -->
    <Style x:Key="Cp.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="{StaticResource Cp.Cyan}" StrokeThickness="1" StrokeDashArray="2 2"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Cửa sổ: nền tối, không viền hệ thống, góc trên phải và dưới trái vát 22px ===== -->
    <Style x:Key="Cp.Window" TargetType="Window">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource Cp.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Cp.Font}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <!-- Kéo cửa sổ bằng thanh tiêu đề tự vẽ cao 44px. -->
                <WindowChrome CaptionHeight="44" GlassFrameThickness="0" ResizeBorderThickness="0"
                              CornerRadius="0" UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <th:ChamferBorder Background="{StaticResource Cp.Background}" BorderBrush="{StaticResource Cp.Track}"
                                      BorderThickness="1" TopRight="22" BottomLeft="22">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Height="44" Padding="16,0,26,0"
                                    BorderBrush="{StaticResource Cp.Red}" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{DynamicResource Cp.CloseButton}" Content="[ X ]"
                                            Command="{x:Static SystemCommands.CloseWindowCommand}"
                                            WindowChrome.IsHitTestVisibleInChrome="True" />
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="FPS//OVERLAY" Foreground="{StaticResource Cp.Yellow}" FontWeight="Bold" FontSize="20" />
                                        <Run Text=" " FontSize="20" />
                                        <Run Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                             Foreground="{StaticResource Cp.Red}" FontFamily="{StaticResource Cp.Mono}" FontSize="11" />
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                            <ContentPresenter />
                        </DockPanel>
                    </th:ChamferBorder>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút [ X ] trên thanh tiêu đề -->
    <Style x:Key="Cp.CloseButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Cp.Red}" />
        <Setter Property="FontFamily" Value="{StaticResource Cp.Mono}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="4,2">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Cp.Yellow}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Chữ ===== -->
    <!-- Tiêu đề mục: "// GIAO DIỆN", gạch đứt bên dưới -->
    <Style x:Key="Cp.Section" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource Cp.Red}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,8,0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Label">
                    <StackPanel>
                        <ContentPresenter Margin="0,0,0,3" />
                        <Rectangle Height="1" Stroke="{StaticResource Cp.Dashed}" StrokeThickness="1"
                                   StrokeDashArray="3 2" SnapsToDevicePixels="True" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nhãn của một dòng cài đặt; lề trên/dưới tạo khoảng cách giữa các dòng -->
    <Style x:Key="Cp.FieldLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,7,12,7" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Số ở cột phải: JetBrains Mono xanh cyan -->
    <Style x:Key="Cp.Value" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Cp.Mono}" />
        <Setter Property="Foreground" Value="{StaticResource Cp.Cyan}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Nút ===== -->
    <Style x:Key="Cp.ButtonBase" TargetType="Button">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Cp.FocusVisual}" />
        <Setter Property="Padding" Value="18,6" />
    </Style>

    <!-- Nút chính: nền vàng, chữ đen -->
    <Style x:Key="Cp.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Cp.ButtonBase}">
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <th:ChamferBorder x:Name="Bd" Background="{StaticResource Cp.Yellow}" BottomRight="8"
                                      BorderBrush="{StaticResource Cp.Yellow}" BorderThickness="1"
                                      Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </th:ChamferBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Cp.YellowHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Cp.YellowPressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút phụ: viền đỏ, chữ đỏ -->
    <Style x:Key="Cp.GhostButton" TargetType="Button" BasedOn="{StaticResource Cp.ButtonBase}">
        <Setter Property="Foreground" Value="{StaticResource Cp.Red}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <th:ChamferBorder x:Name="Bd" Background="Transparent" BottomRight="8"
                                      BorderBrush="{StaticResource Cp.Red}" BorderThickness="1"
                                      Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </th:ChamferBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Cp.RedTint}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Cp.Red}" />
                            <Setter Property="Foreground" Value="Black" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Nút phân đoạn (RadioButton): chọn = nền vàng chữ đen ===== -->
    <Style x:Key="Cp.Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Cp.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Padding" Value="12,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Cp.FocusVisual}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <th:ChamferBorder x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource Cp.Outline}"
                                      BorderThickness="1" BottomRight="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </th:ChamferBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Cp.Yellow}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Cp.Yellow}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Cp.Yellow}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="FontWeight" Value="Bold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Thanh trượt: rãnh #2A2A35, phần đã chọn cyan phát sáng, núm vàng nghiêng ===== -->
    <Style x:Key="Cp.SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Rectangle Height="4" VerticalAlignment="Center" Fill="{StaticResource Cp.Cyan}">
                            <Rectangle.Effect>
                                <DropShadowEffect Color="#00F0FF" ShadowDepth="0" BlurRadius="8" Opacity="0.9" />
                            </Rectangle.Effect>
                        </Rectangle>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Cp.SliderRest" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Rectangle Height="4" VerticalAlignment="Center" Fill="{StaticResource Cp.Track}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Cp.SliderThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Rectangle x:Name="Knob" Width="10" Height="16" Fill="{StaticResource Cp.Yellow}"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <SkewTransform AngleX="-15" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Cp.YellowHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Cp.Slider" TargetType="Slider">
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Cp.FocusVisual}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="22" Background="Transparent">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Cp.SliderFill}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Cp.SliderRest}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Cp.SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Công tắc (ToggleButton) ===== -->
    <Style x:Key="Cp.Switch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Cp.FocusVisual}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <th:ChamferBorder x:Name="Bd" Width="40" Height="18" Background="{StaticResource Cp.Track}"
                                      BorderBrush="{StaticResource Cp.Track}" BorderThickness="1" BottomRight="5">
                        <Rectangle x:Name="Knob" Width="12" Height="12" Margin="2,0" HorizontalAlignment="Left"
                                   VerticalAlignment="Center" Fill="{StaticResource Cp.KnobOff}" />
                    </th:ChamferBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Cp.Yellow}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Cp.Yellow}" />
                            <Setter TargetName="Knob" Property="Fill" Value="Black" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Ô nhập mã hex: Tag="invalid" thì viền đỏ ===== -->
    <Style x:Key="Cp.HexBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Cp.Mono}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Cp.Cyan}" />
        <Setter Property="CaretBrush" Value="{StaticResource Cp.Yellow}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Cp.Cyan}" />
        <Setter Property="BorderBrush" Value="{StaticResource Cp.Outline}" />
        <Setter Property="MaxLength" Value="7" />
        <Setter Property="CharacterCasing" Value="Upper" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <!-- Ô nhập tự đổi viền khi focus (trigger bên dưới), không cần khung focus riêng. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{StaticResource Cp.Field}" BorderThickness="1"
                            BorderBrush="{TemplateBinding BorderBrush}" Padding="4,2">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Cp.Yellow}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Cp.Cyan}" />
            </Trigger>
            <Trigger Property="Tag" Value="invalid">
                <Setter Property="BorderBrush" Value="{StaticResource Cp.Red}" />
                <Setter Property="Foreground" Value="{StaticResource Cp.Red}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Ô màu gợi ý (RadioButton): Background là màu; chọn = khung vàng ===== -->
    <Style x:Key="Cp.Swatch" TargetType="RadioButton">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Cp.FocusVisual}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Ring" Background="Transparent" BorderBrush="Transparent" BorderThickness="2">
                        <Border BorderBrush="#555555" BorderThickness="1" Background="{TemplateBinding Background}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="#88FCEE0A" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Cp.Yellow}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

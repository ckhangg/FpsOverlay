<Window x:Class="FpsOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:FpsOverlay.Core.Settings;assembly=FpsOverlay.Core"
        Style="{StaticResource Cp.Window}"
        Width="640"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen">
    <!-- Mọi chữ được đặt từ code theo ngôn ngữ (Loc); các thứ trong XAML chỉ là bố cục. -->
    <!-- Nội dung cuộn được; hai nút Khôi phục/Xong nằm ngoài vùng cuộn nên luôn thấy. -->
    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="18,10,18,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="76" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- // GIAO DIỆN -->
        <Label x:Name="AppearanceSection" Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource Cp.Section}" />

        <TextBlock x:Name="LanguageLabel" Grid.Row="1" Style="{StaticResource Cp.FieldLabel}" />
        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
            <!-- Tên ngôn ngữ không dịch -->
            <RadioButton x:Name="LanguageVi" GroupName="Language" Style="{StaticResource Cp.Segment}" Content="Tiếng Việt"
                         Tag="{x:Static s:AppLanguage.Vietnamese}" Checked="OnLanguageChecked" />
            <RadioButton x:Name="LanguageEn" GroupName="Language" Style="{StaticResource Cp.Segment}" Content="English"
                         Tag="{x:Static s:AppLanguage.English}" Checked="OnLanguageChecked" />
        </StackPanel>

        <TextBlock x:Name="StyleLabel" Grid.Row="2" Style="{StaticResource Cp.FieldLabel}" />
        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
            <RadioButton x:Name="StyleClassic" GroupName="Style" Style="{StaticResource Cp.Segment}"
                         Tag="{x:Static s:OverlayStyle.Classic}" Checked="OnStyleChecked" />
            <RadioButton x:Name="StyleCyberpunk" GroupName="Style" Style="{StaticResource Cp.Segment}"
                         Tag="{x:Static s:OverlayStyle.Cyberpunk}" Checked="OnStyleChecked" />
            <RadioButton x:Name="StyleNeonPurple" GroupName="Style" Style="{StaticResource Cp.Segment}"
                         Tag="{x:Static s:OverlayStyle.NeonPurple}" Checked="OnStyleChecked" />
            <RadioButton x:Name="StyleTerminalGreen" GroupName="Style" Style="{StaticResource Cp.Segment}"
                         Tag="{x:Static s:OverlayStyle.TerminalGreen}" Checked="OnStyleChecked" />
        </StackPanel>

        <TextBlock x:Name="CornerLabel" Grid.Row="3" Style="{StaticResource Cp.FieldLabel}" />
        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
            <RadioButton x:Name="CornerTopLeft" GroupName="Corner" Style="{StaticResource Cp.Segment}"
                         Tag="{x:Static s:OverlayCorner.TopLeft}" Checked="OnCornerChecked" Click="OnCornerChecked" />
            <RadioButton x:Name="CornerTopRight" GroupName="Corner" Style="{StaticResource Cp.Segment}"
                         Tag="{x:Static s:OverlayCorner.TopRight}" Checked="OnCornerChecked" Click="OnCornerChecked" />
            <RadioButton x:Name="CornerBottomLeft" GroupName="Corner" Style="{StaticResource Cp.Segment}"
                         Tag="{x:Static s:OverlayCorner.BottomLeft}" Checked="OnCornerChecked" Click="OnCornerChecked" />
            <RadioButton x:Name="CornerBottomRight" GroupName="Corner" Style="{StaticResource Cp.Segment}"
                         Tag="{x:Static s:OverlayCorner.BottomRight}" Checked="OnCornerChecked" Click="OnCornerChecked" />
        </StackPanel>

        <TextBlock x:Name="LayoutLabel" Grid.Row="4" Style="{StaticResource Cp.FieldLabel}" />
        <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
            <RadioButton x:Name="LayoutHorizontal" GroupName="Layout" Style="{StaticResource Cp.Segment}"
                         Tag="{x:Static s:OverlayLayout.Horizontal}" Checked="OnLayoutChecked" />
            <RadioButton x:Name="LayoutVertical" GroupName="Layout" Style="{StaticResource Cp.Segment}"
                         Tag="{x:Static s:OverlayLayout.Vertical}" Checked="OnLayoutChecked" />
        </StackPanel>

        <TextBlock x:Name="ScaleLabel" Grid.Row="5" Style="{StaticResource Cp.FieldLabel}" />
        <Slider x:Name="ScaleSlider" Grid.Row="5" Grid.Column="1" Style="{StaticResource Cp.Slider}"
                Minimum="50" Maximum="300" TickFrequency="10" SmallChange="10" LargeChange="10"
                ValueChanged="OnScaleChanged" />
        <TextBlock x:Name="ScaleValue" Grid.Row="5" Grid.Column="2" Style="{StaticResource Cp.Value}" />

        <TextBlock x:Name="OpacityLabel" Grid.Row="6" Style="{StaticResource Cp.FieldLabel}" />
        <Slider x:Name="OpacitySlider" Grid.Row="6" Grid.Column="1" Style="{StaticResource Cp.Slider}"
                Minimum="0" Maximum="100" TickFrequency="5" SmallChange="5" LargeChange="5"
                ValueChanged="OnOpacityChanged" />
        <TextBlock x:Name="OpacityValue" Grid.Row="6" Grid.Column="2" Style="{StaticResource Cp.Value}" />

                <TextBlock x:Name="OnlyInGameLabel" Grid.Row="7" Style="{StaticResource Cp.FieldLabel}" />
        <ToggleButton x:Name="OnlyInGameSwitch" Grid.Row="7" Grid.Column="1" Style="{StaticResource Cp.Switch}"
                      Checked="OnOnlyInGameChanged" Unchecked="OnOnlyInGameChanged" />

        <!-- Danh sách ứng dụng: thu gọn mặc định; các dòng được dựng lại từ code khi hai danh sách đổi. -->
        <StackPanel Grid.Row="8" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,2,0,2">
            <Button x:Name="AppListsButton" Style="{StaticResource Cp.GhostButton}" FontSize="12" Padding="12,3"
                    Tag="AppListsPanel" Click="OnToggleClick" />
            <TextBlock x:Name="AppListsSummary" Style="{StaticResource Cp.FieldLabel}" Margin="12,0,0,0" FontSize="11"
                       Foreground="{StaticResource Cp.KnobOff}" />
        </StackPanel>
        <StackPanel x:Name="AppListsPanel" Grid.Row="9" Grid.ColumnSpan="3" Visibility="Collapsed" Margin="0,2,0,8" />

        <!-- // MÀU SẮC (của phong cách đang chọn): thanh tiêu đề bấm được, tóm tắt là ba ô màu nhỏ. -->
        <Grid Grid.Row="10" Grid.ColumnSpan="3" Background="Transparent" Cursor="Hand" Tag="ColorsPanel"
              MouseLeftButtonUp="OnHeaderMouseUp">
            <Label x:Name="ColorsSection" Style="{StaticResource Cp.Section}" />
            <StackPanel x:Name="ColorsSummary" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,11,0,0" IsHitTestVisible="False">
                <Border x:Name="LabelSummarySwatch" Width="14" Height="14" Margin="3,0,0,0" BorderThickness="1"
                        BorderBrush="{StaticResource Cp.Dashed}" />
                <Border x:Name="ValueSummarySwatch" Width="14" Height="14" Margin="3,0,0,0" BorderThickness="1"
                        BorderBrush="{StaticResource Cp.Dashed}" />
                <Border x:Name="FpsSummarySwatch" Width="14" Height="14" Margin="3,0,0,0" BorderThickness="1"
                        BorderBrush="{StaticResource Cp.Dashed}" />
            </StackPanel>
        </Grid>
        <Grid x:Name="ColorsPanel" Grid.Row="11" Grid.ColumnSpan="3" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="76" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="LabelColorLabel" Grid.Row="0" Style="{StaticResource Cp.FieldLabel}" />
            <StackPanel x:Name="LabelSwatches" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" />
            <TextBox x:Name="LabelHex" Grid.Row="0" Grid.Column="2" Style="{StaticResource Cp.HexBox}"
                     TextChanged="OnHexChanged" LostKeyboardFocus="OnHexLostFocus" />

            <TextBlock x:Name="ValueColorLabel" Grid.Row="1" Style="{StaticResource Cp.FieldLabel}" />
            <StackPanel x:Name="ValueSwatches" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" />
            <TextBox x:Name="ValueHex" Grid.Row="1" Grid.Column="2" Style="{StaticResource Cp.HexBox}"
                     TextChanged="OnHexChanged" LostKeyboardFocus="OnHexLostFocus" />

            <TextBlock x:Name="FpsColorLabel" Grid.Row="2" Style="{StaticResource Cp.FieldLabel}" />
            <StackPanel x:Name="FpsSwatches" Grid.Row="2" Grid.Column="1" Orientation="Horizontal" />
            <TextBox x:Name="FpsHex" Grid.Row="2" Grid.Column="2" Style="{StaticResource Cp.HexBox}"
                     TextChanged="OnHexChanged" LostKeyboardFocus="OnHexLostFocus" />
        </Grid>

        <!-- // MÀU THEO FPS -->
        <Grid Grid.Row="12" Grid.ColumnSpan="3" Background="Transparent" Cursor="Hand" Tag="FpsColorPanel"
              MouseLeftButtonUp="OnHeaderMouseUp">
            <Label x:Name="FpsColorSection" Style="{StaticResource Cp.Section}" />
            <TextBlock x:Name="FpsColorSummary" Style="{StaticResource Cp.FieldLabel}" FontSize="11" HorizontalAlignment="Right"
                       VerticalAlignment="Top" Margin="0,12,0,0" Foreground="{StaticResource Cp.KnobOff}" IsHitTestVisible="False" />
        </Grid>
        <Grid x:Name="FpsColorPanel" Grid.Row="13" Grid.ColumnSpan="3" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="76" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="ColorByFpsLabel" Grid.Row="0" Style="{StaticResource Cp.FieldLabel}" />
            <ToggleButton x:Name="ColorByFpsSwitch" Grid.Row="0" Grid.Column="1" Style="{StaticResource Cp.Switch}"
                          Checked="OnColorByFpsChanged" Unchecked="OnColorByFpsChanged" />

            <!-- Mốc tốt luôn > mốc kém: khoảng thật của hai thanh là 11–240 và 10–239. -->
            <TextBlock x:Name="GoodLabel" Grid.Row="1" Style="{StaticResource Cp.FieldLabel}" />
            <Slider x:Name="GoodSlider" Grid.Row="1" Grid.Column="1" Style="{StaticResource Cp.Slider}"
                    Minimum="11" Maximum="240" TickFrequency="1" SmallChange="1" LargeChange="10"
                    ValueChanged="OnGoodChanged" />
            <TextBlock x:Name="GoodValue" Grid.Row="1" Grid.Column="2" Style="{StaticResource Cp.Value}" />

            <TextBlock x:Name="BadLabel" Grid.Row="2" Style="{StaticResource Cp.FieldLabel}" />
            <Slider x:Name="BadSlider" Grid.Row="2" Grid.Column="1" Style="{StaticResource Cp.Slider}"
                    Minimum="10" Maximum="239" TickFrequency="1" SmallChange="1" LargeChange="10"
                    ValueChanged="OnBadChanged" />
            <TextBlock x:Name="BadValue" Grid.Row="2" Grid.Column="2" Style="{StaticResource Cp.Value}" />
        </Grid>

        <!-- // THÔNG SỐ -->
        <Label x:Name="StatsSection" Grid.Row="14" Grid.ColumnSpan="3" Style="{StaticResource Cp.Section}" />

        <StackPanel Grid.Row="15" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,2,0,2">
            <Button x:Name="StatsButton" Style="{StaticResource Cp.GhostButton}" FontSize="12" Padding="12,3"
                    Tag="StatsPanel" Click="OnToggleClick" />
            <TextBlock x:Name="StatsSummary" Style="{StaticResource Cp.FieldLabel}" Margin="12,0,0,0" FontSize="11"
                       Foreground="{StaticResource Cp.KnobOff}" />
        </StackPanel>

        <!-- Mười ô chọn thông số, hai cột theo nhóm (trái: FPS/GPU, phải: GPU thêm/CPU/RAM); thu gọn mặc định. -->
        <Grid x:Name="StatsPanel" Grid.Row="16" Grid.ColumnSpan="3" Visibility="Collapsed" Margin="0,2,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <CheckBox x:Name="OnePercentCheck" Style="{StaticResource Cp.Check}" Checked="OnStatChanged" Unchecked="OnStatChanged" />
                <CheckBox x:Name="GpuLoadCheck" Style="{StaticResource Cp.Check}" Checked="OnStatChanged" Unchecked="OnStatChanged" />
                <CheckBox x:Name="GpuTempCheck" Style="{StaticResource Cp.Check}" Checked="OnStatChanged" Unchecked="OnStatChanged" />
                <CheckBox x:Name="GpuMemoryCheck" Style="{StaticResource Cp.Check}" Checked="OnStatChanged" Unchecked="OnStatChanged" />
                <CheckBox x:Name="GpuClockCheck" Style="{StaticResource Cp.Check}" Checked="OnStatChanged" Unchecked="OnStatChanged" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <CheckBox x:Name="GpuPowerCheck" Style="{StaticResource Cp.Check}" Checked="OnStatChanged" Unchecked="OnStatChanged" />
                <CheckBox x:Name="GpuFanCheck" Style="{StaticResource Cp.Check}" Checked="OnStatChanged" Unchecked="OnStatChanged" />
                <CheckBox x:Name="CpuLoadCheck" Style="{StaticResource Cp.Check}" Checked="OnStatChanged" Unchecked="OnStatChanged" />
                <CheckBox x:Name="CpuTempCheck" Style="{StaticResource Cp.Check}" Checked="OnStatChanged" Unchecked="OnStatChanged" />
                <CheckBox x:Name="RamCheck" Style="{StaticResource Cp.Check}" Checked="OnStatChanged" Unchecked="OnStatChanged" />
            </StackPanel>
        </Grid>

        <!-- Chỉ hiện khi chưa đọc được nhiệt độ CPU (thiếu PawnIO); nút cài chỉ hiện khi PawnIO chưa cài. Nằm ngoài ô thu gọn. -->
        <StackPanel x:Name="PawnIoPanel" Grid.Row="17" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed"
                    Margin="0,0,0,6">
            <TextBlock x:Name="PawnIoNote" Style="{StaticResource Cp.FieldLabel}" Margin="0,0,0,4" FontSize="11"
                       TextWrapping="Wrap" Foreground="{StaticResource Cp.KnobOff}" />
            <Button x:Name="PawnIoInstallButton" HorizontalAlignment="Left" Style="{StaticResource Cp.GhostButton}"
                    FontSize="12" Padding="12,3" Click="OnInstallPawnIoClick" />
            <TextBlock x:Name="PawnIoStatus" Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap"
                       FontFamily="{StaticResource Cp.Mono}" FontSize="11" Foreground="{StaticResource Cp.Cyan}" />
        </StackPanel>

        <!-- // CẢNH BÁO -->
        <Grid Grid.Row="18" Grid.ColumnSpan="3" Background="Transparent" Cursor="Hand" Tag="AlertsPanel"
              MouseLeftButtonUp="OnHeaderMouseUp">
            <Label x:Name="AlertsSection" Style="{StaticResource Cp.Section}" />
            <TextBlock x:Name="AlertsSummary" Style="{StaticResource Cp.FieldLabel}" FontSize="11" HorizontalAlignment="Right"
                       VerticalAlignment="Top" Margin="0,12,0,0" Foreground="{StaticResource Cp.KnobOff}" IsHitTestVisible="False" />
        </Grid>
        <Grid x:Name="AlertsPanel" Grid.Row="19" Grid.ColumnSpan="3" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="76" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="GpuHotLabel" Grid.Row="0" Style="{StaticResource Cp.FieldLabel}" />
            <Slider x:Name="GpuHotSlider" Grid.Row="0" Grid.Column="1" Style="{StaticResource Cp.Slider}"
                    Minimum="50" Maximum="110" TickFrequency="1" SmallChange="1" LargeChange="5"
                    ValueChanged="OnGpuHotChanged" />
            <TextBlock x:Name="GpuHotValue" Grid.Row="0" Grid.Column="2" Style="{StaticResource Cp.Value}" />

            <TextBlock x:Name="CpuHotLabel" Grid.Row="1" Style="{StaticResource Cp.FieldLabel}" />
            <Slider x:Name="CpuHotSlider" Grid.Row="1" Grid.Column="1" Style="{StaticResource Cp.Slider}"
                    Minimum="50" Maximum="110" TickFrequency="1" SmallChange="1" LargeChange="5"
                    ValueChanged="OnCpuHotChanged" />
            <TextBlock x:Name="CpuHotValue" Grid.Row="1" Grid.Column="2" Style="{StaticResource Cp.Value}" />

            <TextBlock x:Name="HotSecondsLabel" Grid.Row="2" Style="{StaticResource Cp.FieldLabel}" />
            <Slider x:Name="HotSecondsSlider" Grid.Row="2" Grid.Column="1" Style="{StaticResource Cp.Slider}"
                    Minimum="0" Maximum="60" TickFrequency="1" SmallChange="1" LargeChange="5"
                    ValueChanged="OnHotSecondsChanged" />
            <TextBlock x:Name="HotSecondsValue" Grid.Row="2" Grid.Column="2" Style="{StaticResource Cp.Value}" />

            <TextBlock x:Name="HotBlinkLabel" Grid.Row="3" Style="{StaticResource Cp.FieldLabel}" />
            <ToggleButton x:Name="HotBlinkSwitch" Grid.Row="3" Grid.Column="1" Style="{StaticResource Cp.Switch}"
                          Checked="OnHotAlertToggled" Unchecked="OnHotAlertToggled" />

            <TextBlock x:Name="HotSoundLabel" Grid.Row="4" Style="{StaticResource Cp.FieldLabel}" />
            <ToggleButton x:Name="HotSoundSwitch" Grid.Row="4" Grid.Column="1" Style="{StaticResource Cp.Switch}"
                          Checked="OnHotAlertToggled" Unchecked="OnHotAlertToggled" />

            <Button x:Name="TestAlertButton" Grid.Row="5" Grid.ColumnSpan="3" HorizontalAlignment="Left" Margin="0,4,0,0"
                    Style="{StaticResource Cp.GhostButton}" Click="OnTestAlertClick" />
        </Grid>

        <!-- // HỆ THỐNG -->
        <Label x:Name="SystemSection" Grid.Row="20" Grid.ColumnSpan="3" Style="{StaticResource Cp.Section}" />

        <TextBlock x:Name="AutostartLabel" Grid.Row="21" Style="{StaticResource Cp.FieldLabel}" />
        <ToggleButton x:Name="AutostartSwitch" Grid.Row="21" Grid.Column="1" Style="{StaticResource Cp.Switch}"
                      Checked="OnAutostartChanged" Unchecked="OnAutostartChanged" />

        <TextBlock x:Name="LogLabel" Grid.Row="22" Style="{StaticResource Cp.FieldLabel}" />
        <ToggleButton x:Name="LogSwitch" Grid.Row="22" Grid.Column="1" Style="{StaticResource Cp.Switch}"
                      Checked="OnLogChanged" Unchecked="OnLogChanged" />

        <Button x:Name="OpenLogButton" Grid.Row="23" Grid.ColumnSpan="3" HorizontalAlignment="Left" Margin="0,4,0,0"
                Style="{StaticResource Cp.GhostButton}" Click="OnOpenLogFolderClick" />

    </Grid>
    </ScrollViewer>
        <DockPanel Grid.Row="1" Margin="18,10,18,18" LastChildFill="False">
            <Button x:Name="ResetButton" DockPanel.Dock="Left" Style="{StaticResource Cp.GhostButton}" Click="OnResetClick" />
            <!-- Số phiên bản: chữ nhỏ, mờ, căn trái cạnh nút Khôi phục. -->
            <TextBlock x:Name="VersionText" DockPanel.Dock="Left" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="11"
                       FontFamily="{StaticResource Cp.Mono}" Foreground="{StaticResource Cp.KnobOff}" />
            <Button x:Name="DoneButton" DockPanel.Dock="Right" Style="{StaticResource Cp.PrimaryButton}" IsCancel="True"
                    Click="OnDoneClick" />
        </DockPanel>
    </Grid>
</Window>

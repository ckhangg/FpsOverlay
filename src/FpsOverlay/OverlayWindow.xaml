<Window x:Class="FpsOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FPS Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Left="8"
        Top="8">
    <TextBlock x:Name="FpsText"
               Text="--"
               Foreground="LimeGreen"
               FontSize="24"
               FontWeight="Bold"
               FontFamily="Consolas">
        <TextBlock.Effect>
            <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="4" Opacity="1" />
        </TextBlock.Effect>
    </TextBlock>
</Window>

<Window x:Class="FpsOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FPS Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        Left="8"
        Top="8">
    <!-- Kích cỡ: phóng cả dải (chữ, lề, nền) bằng LayoutTransform để cửa sổ SizeToContent co giãn theo. -->
    <Border x:Name="Chrome">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
        </Border.LayoutTransform>
        <!-- Hàng ngang các mục nhãn + giá trị; đợt 3 sẽ thêm GPU, CPU, RAM vào đây. -->
        <StackPanel x:Name="Items" Orientation="Horizontal">
            <TextBlock x:Name="FpsItem" VerticalAlignment="Center"><Run x:Name="FpsLabel" Text="FPS" /><Run x:Name="FpsGap" Text=" " /><InlineUIContainer BaselineAlignment="Baseline"><TextBlock x:Name="FpsValue" Text="--" /></InlineUIContainer></TextBlock>
        </StackPanel>
    </Border>
</Window>

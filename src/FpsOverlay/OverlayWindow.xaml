<Window x:Class="FpsOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FPS Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True">
    <!-- Root có lề trong suốt chỉ khi viền phát sáng, để ánh sáng không bị mép cửa sổ cắt. -->
    <Grid x:Name="Root">
        <!-- Viền phát sáng (Neon): Border riêng phía sau nội dung mang DropShadowEffect, để chữ không bị nhoè.
             Nằm ngoài LayoutTransform nên độ toả tính bằng DIP; độ dày và bo góc nhân Scale trong code. -->
        <Border x:Name="GlowFrame" Visibility="Collapsed" />
        <!-- Kích cỡ: phóng cả dải (chữ, lề, nền) bằng LayoutTransform để cửa sổ SizeToContent co giãn theo. -->
        <Border x:Name="Chrome">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
            </Border.LayoutTransform>
            <Grid>
                <!-- Bố cục ngang: hàng các mục nhãn + giá trị; các mục được dựng trong code (mục FPS rồi một mục cho mỗi StatRow). -->
                <StackPanel x:Name="Items" Orientation="Horizontal" />
                <!-- Bố cục dọc: bảng 3 cột (nhãn | ô First căn phải | ô Second), mỗi dòng một hàng; hàng được thêm trong code.
                     Các ô là chính các đối tượng chữ của bố cục ngang, chuyển sang đây khi đổi bố cục. -->
                <Grid x:Name="Table" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </Grid>
        </Border>
        <!-- Viền đứt nét của chế độ di chuyển: vẽ đè lên khối (nét nằm trong mép), không đổi kích thước khối. -->
        <Rectangle x:Name="MoveOutline" Visibility="Collapsed" IsHitTestVisible="False"
                   Stroke="#E6FFFFFF" StrokeThickness="1" StrokeDashArray="4 3" />
    </Grid>
</Window>

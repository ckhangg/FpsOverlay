<Window x:Class="FpsOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FPS Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True">
    <!-- Kích cỡ: phóng cả dải (chữ, lề, nền) bằng LayoutTransform để cửa sổ SizeToContent co giãn theo. -->
    <Border x:Name="Chrome">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
        </Border.LayoutTransform>
        <!-- Hàng ngang các mục nhãn + giá trị; các mục được dựng trong code (mục FPS rồi một mục cho mỗi StatRow). -->
        <StackPanel x:Name="Items" Orientation="Horizontal" />
    </Border>
</Window>

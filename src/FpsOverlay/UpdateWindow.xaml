<Window x:Class="FpsOverlay.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource Ui.Window}"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen">
    <!-- Mọi chữ được đặt từ code theo ngôn ngữ (Loc); các thứ trong XAML chỉ là bố cục. -->
    <StackPanel Margin="18,10,18,18">
        <Label x:Name="TitleSection" Style="{DynamicResource Ui.Section}" />

        <TextBlock x:Name="VersionsText" TextWrapping="Wrap" Margin="0,6,0,8" />

        <!-- Ghi chú phát hành: văn bản thuần, cuộn được, cao tối đa khoảng 20 dòng. -->
        <Border x:Name="NotesBox" BorderThickness="1" BorderBrush="{DynamicResource Ui.Outline}"
                Background="{DynamicResource Ui.Field}" Padding="10,6">
            <ScrollViewer Style="{DynamicResource Ui.ScrollViewer}" MaxHeight="300"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontFamily="{DynamicResource Ui.Mono}"
                           FontSize="{DynamicResource Ui.CompactFontSize}" Foreground="{DynamicResource Ui.Secondary}" />
            </ScrollViewer>
        </Border>

        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="LaterButton" DockPanel.Dock="Left" Style="{DynamicResource Ui.GhostButton}" IsCancel="True"
                    Click="OnLaterClick" />
            <Button x:Name="SkipButton" DockPanel.Dock="Left" Style="{DynamicResource Ui.GhostButton}" Margin="8,0,0,0"
                    Click="OnSkipClick" />
            <Button x:Name="PrimaryButton" DockPanel.Dock="Right" Style="{DynamicResource Ui.PrimaryButton}" IsDefault="True"
                    Click="OnPrimaryClick" />
        </DockPanel>
    </StackPanel>
</Window>
